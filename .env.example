# Copy to .env (or set these in your hosting dashboard) and restart the server.

# Port the web server listens on
PORT=3000

# Admin login. Leave ADMIN_PASSWORD empty to disable admin login entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random string used to sign admin sessions. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Hours an admin stays logged in
SESSION_HOURS=12

# Set to 1 when running behind a reverse proxy / hosting platform that terminates HTTPS (Render, Railway, nginx, Caddy...)
TRUST_PROXY=0

# Branding and currency symbols
SITE_NAME=Matilda Home Catalog
RETAIL_CURRENCY=₦
COST_CURRENCY=$
COST_LOCAL_CURRENCY=₦

# Where the SQLite database and photos are stored (mount a persistent disk here in production)
DATA_DIR=./data

# Upload limits in MB
MAX_IMAGE_MB=12
MAX_IMPORT_MB=60

# Snap to find (search by photo). 0 turns it off.
VISUAL_SEARCH=1
# Where the MobileNet model files are stored (downloaded once, 17 MB)
MODEL_DIR=./data/models
# Optional: let Claude read brand and model numbers from the photo (better than OCR on messy photos)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
